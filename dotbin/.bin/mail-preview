#!/usr/bin/env python3

import re
import sys
from email import policy
from email.header import decode_header, make_header
from email.parser import BytesParser
from email.utils import parsedate_to_datetime

from bs4 import BeautifulSoup


SEPARATOR = "─" * 78


def decode(value):
    if not value:
        return ""

    try:
        return str(make_header(decode_header(value)))
    except Exception:
        return str(value)


def clean_whitespace(text):
    text = text.replace("\xa0", " ")
    text = text.replace("\r\n", "\n").replace("\r", "\n")

    lines = [line.rstrip() for line in text.splitlines()]

    # Remove whitespace-only lines at the beginning/end.
    while lines and not lines[0].strip():
        lines.pop(0)

    while lines and not lines[-1].strip():
        lines.pop()

    # Never allow more than one completely blank line.
    result = []
    blank = False

    for line in lines:
        if not line.strip():
            if not blank:
                result.append("")
            blank = True
        else:
            result.append(line)
            blank = False

    return "\n".join(result).strip()


def remove_html_quotes(soup):
    """Remove common HTML quoted-reply containers."""

    # Standard HTML quoting.
    for tag in soup.find_all("blockquote"):
        tag.decompose()

    # Gmail.
    for tag in soup.select(
        ".gmail_quote, "
        ".gmail_extra, "
        ".gmail_attr"
    ):
        tag.decompose()

    # Yahoo.
    for tag in soup.select(".yahoo_quoted"):
        tag.decompose()

    # Thunderbird / Mozilla.
    for tag in soup.select(".moz-cite-prefix"):
        tag.decompose()

    # Outlook sometimes uses these classes.
    for tag in soup.select(
        ".OutlookMessageHeader, "
        ".WordSection1"
    ):
        # Don't remove WordSection1 itself — it may contain the
        # actual message. Only handle explicit message headers.
        if "OutlookMessageHeader" in tag.get("class", []):
            tag.decompose()


def convert_tables(soup):
    """
    Convert HTML tables into simple terminal text.

    This deliberately avoids trying to draw a perfect table. Email
    tables are often layout tables rather than actual data tables.
    """

    for table in soup.find_all("table"):
        rows = []

        for tr in table.find_all("tr"):
            cells = tr.find_all(["th", "td"])

            if not cells:
                continue

            values = []

            for cell in cells:
                value = clean_whitespace(
                    cell.get_text(" ", strip=True)
                )

                if value:
                    values.append(value)

            if values:
                rows.append("  |  ".join(values))

        if rows:
            replacement = "\n" + "\n".join(rows) + "\n"
            table.replace_with(replacement)
        else:
            table.decompose()


def convert_links(soup):
    """Keep useful visible link text without exposing tracking URLs."""

    for tag in soup.find_all("a"):
        text = clean_whitespace(
            tag.get_text(" ", strip=True)
        )

        href = tag.get("href")

        # Buttons and image links often have no text.
        if not text:
            image = tag.find("img")

            if image and image.get("alt"):
                text = image["alt"]

        if text:
            tag.replace_with(text)
        elif href:
            tag.replace_with(href)
        else:
            tag.decompose()


def convert_images(soup):
    """Represent useful images without dumping image markup."""

    for tag in soup.find_all("img"):
        alt = clean_whitespace(tag.get("alt", ""))

        if alt:
            tag.replace_with(f"[Image: {alt}]")
        else:
            tag.decompose()


def convert_structure(soup):
    """Add terminal-friendly structure to HTML."""

    # Explicit line breaks.
    for tag in soup.find_all("br"):
        tag.replace_with("\n")

    # Horizontal rules.
    for tag in soup.find_all("hr"):
        tag.replace_with("\n" + SEPARATOR + "\n")

    # Headings.
    for tag in soup.find_all(
        ["h1", "h2", "h3", "h4", "h5", "h6"]
    ):
        text = clean_whitespace(
            tag.get_text(" ", strip=True)
        )

        if text:
            tag.replace_with(
                f"\n{text}\n"
                f"{'-' * min(len(text), 60)}\n"
            )
        else:
            tag.decompose()

    # List items.
    for tag in soup.find_all("li"):
        text = clean_whitespace(
            tag.get_text(" ", strip=True)
        )

        if text:
            tag.replace_with(f"\n• {text}\n")
        else:
            tag.decompose()

    # Paragraph-like blocks.
    block_tags = [
        "address",
        "article",
        "aside",
        "div",
        "dl",
        "dt",
        "dd",
        "figcaption",
        "figure",
        "footer",
        "form",
        "header",
        "main",
        "nav",
        "ol",
        "p",
        "section",
        "ul",
    ]

    for tag in soup.find_all(block_tags):
        tag.insert_before("\n")
        tag.append("\n")

    # Preserve preformatted text.
    for tag in soup.find_all("pre"):
        text = tag.get_text()
        tag.replace_with(
            "\n" + text.rstrip() + "\n"
        )


def html_to_text(html):
    soup = BeautifulSoup(html, "html.parser")

    remove_html_quotes(soup)

    # Remove things with no terminal representation.
    for tag in soup(
        [
            "script",
            "style",
            "head",
            "meta",
            "title",
            "noscript",
            "svg",
        ]
    ):
        tag.decompose()

    convert_tables(soup)
    convert_links(soup)
    convert_images(soup)
    convert_structure(soup)

    return clean_whitespace(
        soup.get_text()
    )


def remove_plaintext_quotes(text):
    lines = text.splitlines()
    result = []

    for line in lines:
        stripped = line.strip()

        # Traditional quoting.
        if stripped.startswith(">"):
            continue

        # Gmail / Apple Mail / many other clients.
        if re.match(
            r"^On .+ wrote:\s*$",
            stripped,
            re.IGNORECASE,
        ):
            break

        # Some clients use "On ...:".
        if re.match(
            r"^On .+:\s*$",
            stripped,
            re.IGNORECASE,
        ):
            break

        # Forwarded messages.
        if re.match(
            r"^-{2,}\s*(Original Message|Forwarded message)\s*-{2,}$",
            stripped,
            re.IGNORECASE,
        ):
            break

        if re.match(
            r"^Begin forwarded message:\s*$",
            stripped,
            re.IGNORECASE,
        ):
            break

        result.append(line)

    return clean_whitespace(
        "\n".join(result)
    )


def remove_signature(text):
    """
    Remove an RFC-style signature beginning with '-- '.
    """

    lines = text.splitlines()

    for i, line in enumerate(lines):
        if line == "-- ":
            return clean_whitespace(
                "\n".join(lines[:i])
            )

    return text


def decode_part(part):
    try:
        return str(part.get_content())
    except Exception:
        payload = part.get_payload(decode=True)

        if payload is None:
            return ""

        charset = part.get_content_charset() or "utf-8"

        try:
            return payload.decode(
                charset,
                errors="replace",
            )
        except LookupError:
            return payload.decode(
                "utf-8",
                errors="replace",
            )


def extract_body(msg):
    plain = []
    html = []

    for part in msg.walk():

        if part.is_multipart():
            continue

        if part.get_content_disposition() == "attachment":
            continue

        content_type = part.get_content_type()

        if content_type == "text/plain":
            text = decode_part(part)
            text = remove_plaintext_quotes(text)
            text = remove_signature(text)

            if text:
                plain.append(text)

        elif content_type == "text/html":
            text = decode_part(part)
            text = html_to_text(text)
            text = remove_signature(text)

            if text:
                html.append(text)

    # multipart/alternative normally gives us both versions.
    # Prefer plain text when available.
    if plain:
        return clean_whitespace(
            "\n\n".join(plain)
        )

    if html:
        return clean_whitespace(
            "\n\n".join(html)
        )

    return ""


def format_date(value):
    try:
        date = parsedate_to_datetime(value)

        if date.tzinfo is not None:
            return date.strftime(
                "%a %d %b %Y %H:%M:%S %z"
            )

        return date.strftime(
            "%a %d %b %Y %H:%M:%S"
        )

    except Exception:
        return decode(value)


def print_header(msg):
    from_ = decode(msg.get("From"))
    to = decode(msg.get("To"))
    cc = decode(msg.get("Cc"))
    subject = decode(msg.get("Subject"))
    date = format_date(msg["Date"]) if msg.get("Date") else ""

    print(f"From:    {from_}")
    print(f"To:      {to}")

    if cc:
        print(f"Cc:      {cc}")

    if subject:
        print(f"Subject: {subject}")

    if date:
        print(f"Date:    {date}")

    print()
    print(SEPARATOR)
    print()


def main():
    if len(sys.argv) != 2:
        print(
            "Usage: mail-preview FILE",
            file=sys.stderr,
        )
        sys.exit(1)

    filename = sys.argv[1]

    try:
        with open(filename, "rb") as f:
            msg = BytesParser(
                policy=policy.default
            ).parse(f)

    except OSError as e:
        print(
            f"mail-preview: {e}",
            file=sys.stderr,
        )
        sys.exit(1)

    print_header(msg)

    text = extract_body(msg)

    if text:
        print(text)
    else:
        print("[No readable message body]")


if __name__ == "__main__":
    main()
