#!/usr/bin/bash

if [ "$#" -lt 3 ]; then
    echo "Usage: vid <dir1> <dir2> <file(s)>"
    exit 1
fi

# Stop the entire run when interrupted, including while waiting for Neovim.
trap 'exit 130' INT
trap 'exit 143' TERM

DIR1=$1
DIR2=$2
shift 2

for i in "$@"; do
    FILE1=$DIR1/$i
    FILE2=$DIR2/$i

    if ! cmp -s -- "$FILE1" "$FILE2"; then
        # Run in the foreground; only continue after a successful editor exit.
        nvim -d "$FILE1" "$FILE2" || exit "$?"
    fi
done
