prefer-no-csd

layout {
    gaps 8
    center-focused-column "never"

    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    struts {}
}

window-rule {
    geometry-corner-radius 1
    clip-to-geometry true
}
